# Supabase (required)
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# App Environment
VITE_APP_ENV=development

# Error Tracking (optional - Sentry)
VITE_SENTRY_DSN=

# App Version (optional - used for Sentry release tracking)
VITE_APP_VERSION=0.0.1

# Assistant (optional): the assistant Worker's URL (DEPLOYMENT.md, Assistant Worker).
# Unset, the app has no Assistant screen. `wrangler dev` serves it at http://localhost:8787.
VITE_ASSISTANT_URL=

# Push Notifications (optional - VAPID public key for Web Push)
VITE_VAPID_PUBLIC_KEY=

# Optional: password for real statements in tests/fixtures/statements/private/ (git-ignored).
# Their parser tests skip when this or the files are absent.
# BDO_STATEMENT_PASSWORD=
